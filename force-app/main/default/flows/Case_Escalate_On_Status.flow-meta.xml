<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <description>Raises the escalation level by one and the priority by one step.</description>
        <name>Raise_Level_And_Priority</name>
        <label>Raise Level And Priority</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Escalation_Level__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NextEscalationLevel</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NextPriority</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_To_Escalation_Queue</name>
        <label>Assign To Escalation Queue</label>
        <locationX>44</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Escalation_Queue.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Skips the reassignment when the queue does not exist, so the flow never blanks the owner.</description>
        <name>Queue_Found</name>
        <label>Queue Found?</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <defaultConnectorLabel>No queue</defaultConnectorLabel>
        <rules>
            <name>Queue_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Escalation_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_To_Escalation_Queue</targetReference>
            </connector>
            <label>Queue Exists</label>
        </rules>
    </decisions>
    <description>When an agent moves a case to Escalated: raises Escalation_Level__c, raises Priority one step and hands the case to the Escalation Support queue. Before-save, so no extra DML.</description>
    <environments>Default</environments>
    <formulas>
        <name>NextEscalationLevel</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.Escalation_Level__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Low becomes Medium; Medium, High or blank become High.</description>
        <name>NextPriority</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Priority}, &quot;Low&quot;, &quot;Medium&quot;, &quot;High&quot;)</expression>
    </formulas>
    <interviewLabel>Case Escalate On Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Escalate On Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Escalation_Queue</name>
        <label>Get Escalation Queue</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Raise_Level_And_Priority</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Escalation_Support</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Escalation_Queue</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Escalated</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
